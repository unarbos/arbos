# Arbos iPhone app — fastlane lanes.
#
# `beta` reproduces the TestFlight path that already shipped build 7 of this
# bundle from unarbos/arbos `.github/workflows/ios.yml`, step for step:
#   1. archive with signing off (CODE_SIGNING_ALLOWED=NO),
#   2. export with method app-store-connect / destination upload / automatic
#      signing, letting Xcode mint the distribution certificate and profile
#      through the App Store Connect API key (-allowProvisioningUpdates).
#
# Secrets come from the environment under the same names as the repo secrets:
#   AC_API_KEY_P8 (key contents) or AC_API_KEY_PATH (file), AC_API_KEY_ID,
#   AC_API_ISSUER_ID, ARBOS_APPLE_TEAM_ID (defaults to the project's team).
# The API key must have "cloud-managed distribution certificate" access
# (App Store Connect → Users and Access → Integrations); a key without it
# fails the export with "Cloud signing permission error".
# Nothing is written into the repo; the key file lives in a temp dir and is
# removed when the lane ends.
#
# Build number: BUILD_NUMBER (UTC `YYYYMMDDHHMM` from ios.yml) plus the last
# 6 digits of the Actions run id when present, else UTC `YYYYMMDDHHMMSS`.
# Apple's CFBundleVersion max is 18 characters; the suffix keeps two main
# pushes in the same minute from colliding on TestFlight ("Redundant Binary
# Upload") without overflowing that limit.
#
# Every xcodebuild runs under `set -o pipefail`; its full output is in
# build/xcodebuild-<lane>.log (ios.yml keeps the logs as an artifact) and the
# console shows the `error:` lines and the verdict. Nothing is cut with
# `tail`: a hidden compile error cost a TestFlight build once.

default_platform(:ios)

PROJECT = "Arbos.xcodeproj"
SCHEME = "Arbos"
DEFAULT_TEAM = "25SCF3Q2AK"

def build_number
  base = ENV["BUILD_NUMBER"] || Time.now.utc.strftime("%Y%m%d%H%M%S")
  run = ENV["GITHUB_RUN_ID"].to_s
  return base if run.empty?
  # 12 (YYYYMMDDHHMM) + 6 = 18, the CFBundleVersion ceiling.
  "#{base}#{run[-6, 6]}"
end

def out_dir
  dir = ENV["ARBOS_OUT"] || File.expand_path("../build", __dir__)
  FileUtils.mkdir_p(dir)
  dir
end

# Swift packages are cloned under ARBOS_SPM_DIR when it is set (ios.yml caches
# that directory between runs), else wherever Xcode keeps them.
def spm_flags
  dir = ENV["ARBOS_SPM_DIR"]
  dir.to_s.empty? ? "" : "-clonedSourcePackagesDirPath '#{dir}' "
end

# Runs an xcodebuild `command` (which starts in the fastlane directory). The
# whole output goes to build/xcodebuild-<name>.log; the console gets the
# `error:` lines and the verdict. `pipefail` keeps xcodebuild's exit status
# (not tee's), and a failure stops the lane with the error count.
def xcodebuild_logged(name, command)
  log = "#{out_dir}/xcodebuild-#{name}.log"
  UI.message("xcodebuild #{name}: full output in #{log}")
  failed = false
  sh("set -o pipefail && #{command} 2>&1 | tee '#{log}'", log: false, error_callback: ->(_output) { failed = true })
  lines = File.exist?(log) ? File.readlines(log) : []
  lines.grep(/error:|\*\* (BUILD|ARCHIVE|EXPORT) (SUCCEEDED|FAILED)/).uniq.each { |line| UI.message(line.chomp) }
  if failed
    errors = lines.grep(/error:/).uniq
    UI.user_error!("xcodebuild #{name} failed (#{errors.size} error lines, see #{log})")
  end
  log
end

# Apple's upload and TestFlight APIs have bad minutes ("temporary issue on TestFlight",
# "No build_beta_detail included", timeouts, 5xx). Those are retried with a backoff of
# 1, 2, 4, 8, 15 minutes; anything else fails at once.
TRANSIENT = /temporary issue|build_beta_detail|timed out|time out|Timeout|Service Unavailable|Bad Gateway|Internal Server Error|\b50[0-4]\b|\b429\b|ECONNRESET|Connection reset|SSL_connect|OpenTimeout|EOFError|unexpected error occurred/i

def transient?(text)
  TRANSIENT.match?(text.to_s)
end

def with_transient_retry(name, log_path: nil)
  delays = [60, 120, 240, 480, 900]
  attempt = 0
  begin
    yield
  rescue StandardError => e
    detail = e.message.dup
    detail << "\n" << File.read(log_path) if log_path && File.exist?(log_path)
    raise unless transient?(detail) && attempt < delays.size
    wait = delays[attempt]
    attempt += 1
    UI.important("#{name}: Apple side hiccup (#{e.message.lines.first.to_s.strip[0, 160]}); retry #{attempt}/#{delays.size} in #{wait / 60} min")
    sleep(wait)
    retry
  end
end

# packages/ArbosFFI products from `./scripts/build-xcframework.sh`
# (ArbosFFIRust.xcframework + Sources/ArbosFFI/ArbosFFI.swift). The local
# ArbosFFI package and the app embed both; archive/test fail loudly when they
# are missing or not built for this commit (CI runs the script before these lanes).
def require_xcframework!
  root = File.expand_path("../../../../packages/ArbosFFI", __dir__)
  xc = File.join(root, "ArbosFFIRust.xcframework")
  swift = File.join(root, "Sources/ArbosFFI/ArbosFFI.swift")
  missing = []
  missing << xc unless File.directory?(xc)
  missing << swift unless File.file?(swift)
  return if missing.empty?
  UI.user_error!(
    "missing ArbosFFI build product(s): #{missing.join(', ')} — " \
    "run ./scripts/build-xcframework.sh from the repo root first"
  )
end

def report_arbosffi_size(archive_path)
  fw = "#{archive_path}/Products/Applications/Arbos.app/Frameworks/ArbosFFI.framework"
  UI.user_error!("archive embeds no ArbosFFI.framework at #{fw}") unless File.directory?(fw)
  bytes = 0
  Dir.glob("#{fw}/**/*", File::FNM_DOTMATCH).each do |p|
    next unless File.file?(p)
    bytes += File.size(p)
  end
  mib = bytes / (1024.0 * 1024.0)
  UI.success(format("ArbosFFI.framework in archive: %.2f MiB (%d bytes)", mib, bytes))
  File.write("#{out_dir}/arbosffi-size.txt", "#{bytes}\n")
end

platform :ios do
  desc "Debug build for the iOS simulator (no signing)"
  lane :sim do
    require_xcframework!
    xcodebuild_logged("sim",
      "cd .. && xcodebuild build -project #{PROJECT} -scheme #{SCHEME} -configuration Debug " \
      "-destination 'platform=iOS Simulator,name=iPhone 17' -derivedDataPath '#{out_dir}/dd' #{spm_flags}" \
      "CODE_SIGNING_ALLOWED=NO")
  end

  # Unit tests (ArbosTests). Needs the gitignored package products from
  # `./scripts/build-xcframework.sh` under packages/ArbosFFI/.
  # Same project, scheme, and simulator destination as `sim`; only the Test
  # action builds ArbosTests (not Run / Archive). Links the ArbosFFI package.
  desc "Run ArbosTests on the iOS simulator (no signing); requires packages/ArbosFFI"
  lane :test do
    require_xcframework!
    xcodebuild_logged("test",
      "cd .. && xcodebuild test -project #{PROJECT} -scheme #{SCHEME} -configuration Debug " \
      "-destination 'platform=iOS Simulator,name=iPhone 17' -derivedDataPath '#{out_dir}/dd' #{spm_flags}" \
      "-only-testing:ArbosUITests/BackSwipeUITests -only-testing:ArbosUITests/ChatSearchCloseUITests " \
      "-skip-testing:ArbosUITests/BackSwipeUITests/testEdgeSwipeBackTransitionTiming -test-iterations 3 " \
      "CODE_SIGNING_ALLOWED=NO")
  end

  desc "Unsigned Release archive (what CI keeps even when no Apple secret is set)"
  lane :archive do
    require_xcframework!
    number = build_number
    archive_path = "#{out_dir}/Arbos.xcarchive"
    log = xcodebuild_logged("archive",
      "cd .. && xcodebuild -project #{PROJECT} -scheme #{SCHEME} " \
      "-configuration Release -destination 'generic/platform=iOS' " \
      "#{spm_flags}-archivePath '#{archive_path}' archive " \
      "CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO " \
      "CURRENT_PROJECT_VERSION=#{number}")
    UI.user_error!("archive has no binary (see #{log})") unless File.executable?("#{archive_path}/Products/Applications/Arbos.app/Arbos")
    report_arbosffi_size(archive_path)
    UI.success("Archive #{archive_path} build #{number}")
    lane_context[:ARBOS_ARCHIVE] = archive_path
    lane_context[:ARBOS_BUILD_NUMBER] = number
  end

  desc "Archive, sign through the App Store Connect API key, upload to TestFlight"
  lane :beta do
    key_id = ENV["AC_API_KEY_ID"]
    issuer_id = ENV["AC_API_ISSUER_ID"]
    team_id = ENV["ARBOS_APPLE_TEAM_ID"] || DEFAULT_TEAM
    missing = []
    missing << "AC_API_KEY_ID" if key_id.to_s.empty?
    missing << "AC_API_ISSUER_ID" if issuer_id.to_s.empty?
    missing << "AC_API_KEY_P8 or AC_API_KEY_PATH" if ENV["AC_API_KEY_P8"].to_s.empty? && ENV["AC_API_KEY_PATH"].to_s.empty?
    UI.user_error!("Apple secrets not set: #{missing.join(', ')}") unless missing.empty?

    archive
    archive_path = lane_context[:ARBOS_ARCHIVE]
    number = lane_context[:ARBOS_BUILD_NUMBER]

    tmp = Dir.mktmpdir("arbos-sign")
    begin
      key_path = ENV["AC_API_KEY_PATH"]
      if key_path.to_s.empty?
        key_path = File.join(tmp, "AuthKey_#{key_id}.p8")
        File.write(key_path, ENV["AC_API_KEY_P8"])
        File.chmod(0o600, key_path)
      end
      options = File.join(tmp, "ExportOptions.plist")
      File.write(options, <<~PLIST)
        <?xml version="1.0" encoding="UTF-8"?>
        <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
        <plist version="1.0">
        <dict>
          <key>method</key><string>app-store-connect</string>
          <key>destination</key><string>upload</string>
          <key>signingStyle</key><string>automatic</string>
          <key>teamID</key><string>#{team_id}</string>
        </dict>
        </plist>
      PLIST
      export_path = "#{out_dir}/TestFlightExport"
      with_transient_retry("TestFlight upload", log_path: "#{out_dir}/xcodebuild-export.log") do
        xcodebuild_logged("export",
          "xcodebuild -exportArchive -archivePath '#{archive_path}' -exportPath '#{export_path}' " \
          "-exportOptionsPlist '#{options}' -allowProvisioningUpdates " \
          "-authenticationKeyPath '#{key_path}' -authenticationKeyID '#{key_id}' " \
          "-authenticationKeyIssuerID '#{issuer_id}'")
      end
      UI.success("Uploaded Arbos build #{number} to TestFlight (bundle com.unarbos.arbos.ios)")
    ensure
      FileUtils.rm_rf(tmp)
    end
  end

  # After `beta`: wait until Apple has processed BUILD_NUMBER, add it to the
  # external group(s) in TESTFLIGHT_GROUPS (default "Arbos public") and submit
  # it for Beta App Review. The internal group has access to every build by
  # itself. CHANGELOG (what to test) defaults to the commit subject. Needs the
  # same AC_API_* secrets as `beta`.
  desc "Add a processed build to the external TestFlight group(s) and submit it for Beta App Review"
  lane :distribute do
    key_id = ENV["AC_API_KEY_ID"]
    issuer_id = ENV["AC_API_ISSUER_ID"]
    key_path = ENV["AC_API_KEY_PATH"]
    UI.user_error!("AC_API_KEY_ID, AC_API_ISSUER_ID and AC_API_KEY_PATH are required") if [key_id, issuer_id, key_path].any? { |v| v.to_s.empty? }
    number = build_number
    groups = (ENV["TESTFLIGHT_GROUPS"] || "Arbos public").split(",").map(&:strip).reject(&:empty?)
    changelog = ENV["CHANGELOG"].to_s.strip
    changelog = "Build #{number}." if changelog.empty?
    api_key = app_store_connect_api_key(key_id: key_id, issuer_id: issuer_id, key_filepath: key_path, in_house: false)
    distribute = lambda do |submit|
      with_transient_retry("TestFlight distribute") do
      upload_to_testflight(
        api_key: api_key,
        app_identifier: "com.unarbos.arbos.ios",
        app_platform: "ios",
        distribute_only: true,
        build_number: number,
        distribute_external: true,
        groups: groups,
        changelog: changelog[0, 4000],
        notify_external_testers: true,
        submit_beta_review: submit,
        reject_build_waiting_for_review: false,
        wait_processing_interval: 30,
        wait_processing_timeout_duration: 1500
      )
      end
    end
    begin
      distribute.call(true)
      UI.success("Build #{number} is in #{groups.join(', ')} and submitted for Beta App Review")
    rescue StandardError => e
      # Apple allows one build per version train in Beta App Review at a time. The group gets
      # the build now; external testers only see it once it is submitted and approved, so wait
      # for the pending review to clear (auto-approval takes seconds once the app has passed
      # Beta App Review) and submit then. A build left unsubmitted never reaches the public link.
      raise unless e.message.include?("Another build is in review")
      UI.important("Another build is already in Beta App Review; adding #{number} to #{groups.join(', ')} now and submitting when the review clears")
      distribute.call(false)
      submitted = false
      15.times do |attempt|
        sleep(60)
        begin
          distribute.call(true)
          submitted = true
          break
        rescue StandardError => again
          raise unless again.message.include?("Another build is in review")
          UI.message("Review still busy (#{attempt + 1}/15); waiting")
        end
      end
      if submitted
        UI.success("Build #{number} is in #{groups.join(', ')} and submitted for Beta App Review (after the earlier review cleared)")
      else
        UI.important("Build #{number} is in #{groups.join(', ')} but NOT submitted for Beta App Review: another build stayed in review for 15 min. Submit it in App Store Connect → TestFlight, or re-run `fastlane distribute`.")
      end
    end
  end
end
