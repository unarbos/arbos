/target/*
# Stub ArbosFFI.xcframework so Xcode can resolve the path before the Run Script
# builds the real one (the iOS gate Mac only runs xcodebuild).
!/target/xcframework/
/target/xcframework/**
!/target/xcframework/ArbosFFI.xcframework/
!/target/xcframework/ArbosFFI.xcframework/Info.plist
/dist
node_modules/
harness/**/dist/
*.db
*.db-wal
*.db-shm
/.arbos-local/
.env

# Never commit credentials: env files, Apple signing material, private keys.
.env.*
!.env.example
*.p8
*.p12
*.pem
*.key
/keys/
/secrets/
__pycache__/

# voice worker (python)
voice/.venv/
voice/**/__pycache__/
voice/tests/fixtures/judge-results.json
