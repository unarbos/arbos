#!/bin/bash
# D64 shell wrapper for Prime Agent's bash(): PRIME_AGENT_BASH_SHELL points here.
# 1. Check the command against the deny-list (same rules as arbos-pi-ext/deny.ts).
# 2. Append one audit line BEFORE running.
# 3. exec /bin/bash with the original arguments.
# Prime calls: $SHELL -c "<command>" (optionally with PRIME_AGENT_BASH_COMMAND_PREFIX prepended).

set -u
AUDIT="${ARBOS_AUDIT_PATH:-${ARBOS_STATE_DIR:-/work/.arbos}/audit.jsonl}"
TRACE="${ARBOS_TRACE_ID:-}"
SESSION="${ARBOS_SESSION_ID:-}"

cmd=""
if [ "${1:-}" = "-c" ] && [ $# -ge 2 ]; then
  cmd="$2"
fi

audit() {
  local input_hash
  mkdir -p "$(dirname "$AUDIT")" 2>/dev/null || return 0
  input_hash="$(printf '%s' "$cmd" | sha256sum 2>/dev/null)" || return 0
  input_hash="${input_hash%% *}"
  jq -cn --arg session "$SESSION" --arg trace_id "$TRACE" --arg cwd "$PWD" \
    --arg denied "$1" --arg input_hash "$input_hash" \
    '{ts: (now * 1000 | floor), kind: "tool_call", tool: "bash", role: "subagent", harness: "prime",
      session: $session, trace_id: $trace_id, cwd: $cwd,
      denied: (if $denied == "" then null else $denied end), input_hash: $input_hash}' \
    2>/dev/null >> "$AUDIT" || true
}

deny() {
  audit "$1"
  echo "arbos: blocked by the deny-list ($1): $2" >&2
  exit 126
}

if [ -n "$cmd" ]; then
  if printf '%s' "$cmd" | grep -Eq 'dtn_[A-Za-z0-9]{20,}|DAYTONA_API_KEY|api\.daytona\.io/api/(api-keys|organizations)'; then
    deny daytona-api-key "Daytona API keys never exist in a box"
  fi
  if printf '%s' "$cmd" | grep -Eq '/(admin|v1/admin|pair/new|devices)(/|\?|[[:space:]]|$)'; then
    deny relay-admin "relay admin endpoints are not reachable with a box token"
  fi
  if printf '%s' "$cmd" | grep -Eq '(^|[[:space:]]|["'"'"'])/work(/[^/[:space:]]+)?/\.arbos/(agentd|audit\.jsonl)'; then
    deny arbos-state-tamper "agentd state and the audit log are not writable by the model"
  fi
  audit ""
fi

exec /bin/bash "$@"
