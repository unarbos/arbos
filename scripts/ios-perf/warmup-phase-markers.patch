+// MEASUREMENT ONLY (perf rig, never in the PR): brackets the warm-up window for the injected
+// side-effect counter (scripts/ios-perf/probe), a no-op when it is not loaded.
+private typealias WarmupProbeFn = @convention(c) (Int32) -> Void
+private let warmupProbeFn: WarmupProbeFn? = dlsym(UnsafeMutableRawPointer(bitPattern: -2), "arbos_probe_phase")
+    .map { unsafeBitCast($0, to: WarmupProbeFn.self) }
+private func warmupProbe(_ phase: Int32) { warmupProbeFn?(phase) }
