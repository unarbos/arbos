[Unit]
Description=Run the Arbos feedback poller every 2 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=2min
AccuracySec=15s
# No Persistent=: it only applies to OnCalendar=, and its stamp file makes systemd count OnBootSec=
# as already fired after a reboot, which leaves OnUnitActiveSec= with no base and the timer idle.

[Install]
WantedBy=timers.target
