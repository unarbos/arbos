# Caddy for arbos.life + relay.arbos.life on Jacob's server. Installed by scripts/deploy/relay-server.sh
# to @WWW_DIR@/Caddyfile and run by arbos-www.service (the :443 Caddy). Port 80 belongs to the
# Affine Caddy on this box, so certificates come from the TLS-ALPN challenge only; both hostnames
# must therefore be DNS-only A records pointing straight at the server (no Cloudflare proxy).
{
	admin off
	auto_https disable_redirects
	# TURN over TLS for calls shares 443 with the sites: connections whose SNI is the TURN hostname are
	# handed raw (no TLS termination here) to LiveKit's TURN/TLS listener; everything else is HTTPS as
	# usual. Needs the caddy-l4 module (scripts/deploy/livekit/build-caddy.sh builds that binary) —
	# a stock caddy rejects this block, so remove it when you do not run LiveKit.
	servers :443 {
		listener_wrappers {
			layer4 {
				# ACME TLS-ALPN challenges for the TURN name stay with Caddy (it owns the certificate).
				@turn {
					tls {
						sni turn.arbos.life
					}
					not {
						tls {
							alpn acme-tls/1
						}
					}
				}
				route @turn {
					proxy 127.0.0.1:5349
				}
			}
			tls
		}
	}
	storage file_system {
		root @WWW_DIR@/caddy-data
	}
	log {
		output file @WWW_DIR@/logs/caddy.log {
			roll_size 10MiB
			roll_keep 3
		}
	}
}

(acme_alpn_only) {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
}

# ---- landing page --------------------------------------------------------------------------------
# Since agent sites (#2060) the apex is proxied by Cloudflare (SSL mode Full (strict)), so the
# TLS-ALPN challenge cannot reach this host for arbos.life: its certificate comes by DNS-01 through
# the zone token in /etc/arbos/www.env (vault item "Cloudflare arbos.life DNS edit", written by
# relay-server.sh into the arbos-www.service drop-in). The other vhosts stay DNS-only + ALPN.
arbos.life {
	tls {
		dns cloudflare {env.CLOUDFLARE_DNS_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}
	root * @WWW_DIR@/site
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}
	# /assets/* is immutable, so anything referenced from HTML under it must carry a content hash or
	# a ?v= in its URL (the OG image is hashed by scripts/site/build-og.py). Browsers, Google and Safari
	# fetch the root favicons by their fixed names, so those get a short lifetime instead (D84 rollout).
	header /assets/* Cache-Control "public, max-age=604800, immutable"
	# Caddy runs same-named directives longest-path-first, so the generic png rule would overwrite the
	# touch icon's header; keep it out of that rule instead.
	@png {
		path /*.png
		not path /apple-touch-icon.png
	}
	header @png Cache-Control "public, max-age=86400"
	# Server invite links (D88): arbos.life/s/<code> is answered by the relay — a page that opens
	# the installed app through arbos://join/<code> and falls back to the download.
	handle /s/* {
		reverse_proxy @RELAY_LISTEN@
	}
	# Group chat invite links: arbos.life/g/<code> → arbos://join-group/<code>.
	handle /g/* {
		reverse_proxy @RELAY_LISTEN@
	}
	header /favicon.ico Cache-Control "public, max-age=3600"
	header /favicon.svg Cache-Control "public, max-age=3600"
	header /apple-touch-icon.png Cache-Control "public, max-age=3600"
	# same redirect as on the relay, so the button keeps working if the relay is down
	import /etc/arbos/download.caddy
	# In-app updates (Mac, stable channel): the newest release's appcast.xml and its
	# …-macos-universal.tar.gz, mirrored into @WWW_DIR@/updates/mac by arbos-refresh-mac-download
	# (on every POST /admin/release and every 15 min). A file that is not mirrored (yet) redirects
	# to the GitHub release asset — the snippet in updates.d names the current tag. The app
	# verifies the Ed25519 signature over the bytes whichever host served them.
	handle_path /updates/mac/* {
		root * @WWW_DIR@/updates/mac
		header /appcast.xml Cache-Control "no-cache"
		import /etc/arbos/updates.d/*.caddy
		file_server
	}
	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			rewrite * /index.html
			file_server
		}
	}
	file_server
}

# ---- relay ----------------------------------------------------------------------------------------
relay.arbos.life {
	import acme_alpn_only
	encode zstd gzip
	header -Server
	# /download/mac → newest edge DMG (rewritten by arbos-refresh-mac-download)
	import /etc/arbos/download.caddy
	# everything else, WebSockets included, goes to the relay
	reverse_proxy @RELAY_LISTEN@ {
		flush_interval -1
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
}

# ---- optional services on this host (LiveKit calls, …) ---------------------------------------------
# One file per service, written by their setup scripts (scripts/deploy/livekit/setup.sh → livekit.caddy).
import /etc/arbos/sites.d/*.caddy
