#!/usr/bin/env bash
# arbos-deploy-hook <relay|agentd|voice> <sha> — ask the relay host to deploy a commit of main.
#
# Called by the feedback loop's poller after a gated merge that touches the relay, the sandbox
# image (agentd) or the voice worker, and by hand. It only queues: it writes one small request
# file and exits 0 at once. The worker (`arbos-deploy.timer`, every minute, root) does the deploy
# after a short debounce — 2 minutes of quiet after the last request, at most 5 minutes after the
# first — so several merges in a row share one deploy and a fix never waits for a batch.
#
# Works as root (sudo) and as the `arbos-feedback` user: the queue lives under the poller's own
# state directory, because its systemd unit has NoNewPrivileges=yes (sudo cannot work there) and
# ProtectSystem=strict (only /var/lib/arbos-feedback is writable).
#
# Exit 0 = queued (or already queued for this sha), 2 = bad arguments, 1 = cannot write the queue.
set -euo pipefail

QUEUE="${ARBOS_DEPLOY_QUEUE:-/var/lib/arbos-feedback/deploy-requests}"
kind="${1:-}"
sha="${2:-}"
case "$kind" in
  relay|agentd|voice) ;;
  *) echo "usage: arbos-deploy-hook <relay|agentd|voice> <sha>" >&2; exit 2 ;;
esac
if ! [[ "$sha" =~ ^[0-9a-fA-F]{7,40}$ ]]; then
  echo "arbos-deploy-hook: '$sha' is not a commit id" >&2
  exit 2
fi
sha="${sha,,}"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/deploy/deploy-state.sh
. "$HERE/deploy-state.sh"

queue_request_locked() {
  local kind="$1" sha="$2" now file first prev_first prev_sha tmp
  mkdir -p "$QUEUE" 2>/dev/null || true
  if [[ ! -w "$QUEUE" ]]; then
    echo "arbos-deploy-hook: cannot write $QUEUE" >&2
    return 1
  fi
  now="$(date -u +%s)"
  file="$QUEUE/$kind"
  first="$now"
  if deploy_request_valid "$file" "$kind"; then
    # Keep the first request time: the 5-minute cap counts from it.
    prev_first="$(sed -n 's/^first_requested_at=//p' "$file" | head -1)"
    if [[ "$prev_first" =~ ^[0-9]+$ ]]; then first="$prev_first"; fi
    prev_sha="$(sed -n 's/^sha=//p' "$file" | head -1)"
    if [[ "$prev_sha" == "$sha" ]]; then
      echo "queued already: $kind $sha"
      return 0
  fi
  fi
  tmp="$(mktemp "$QUEUE/.$kind.XXXXXX")"
  {
    echo "kind=$kind"
    echo "sha=$sha"
    echo "requested_at=$now"
    echo "first_requested_at=$first"
    echo "requested_by=$(id -un)"
  } > "$tmp"
  chmod 0644 "$tmp"
  mv -f "$tmp" "$file"
  echo "queued: $kind $sha"
}
deploy_queue_transaction "$QUEUE" queue_request_locked "$kind" "$sha"
