#!/usr/bin/env bash
# arbos-deploy-hook <relay|agentd|voice> <sha> — ask the relay host to deploy a commit of main.
#
# Called by the feedback loop's poller after a gated merge that touches the relay, the sandbox
# image (agentd) or the voice worker, and by hand. It only queues: it writes one small request
# file and exits 0 at once. The worker (`arbos-deploy.timer`, every minute, root) does the deploy
# after a short debounce — 2 minutes of quiet after the last request, at most 5 minutes after the
# first — so several merges in a row share one deploy and a fix never waits for a batch.
#
# Works as root (sudo) and as the `arbos-feedback` user: the queue lives under the poller's own
# state directory, because its systemd unit has NoNewPrivileges=yes (sudo cannot work there) and
# ProtectSystem=strict (only /var/lib/arbos-feedback is writable).
#
# Exit 0 = queued (or already queued for this sha), 2 = bad arguments, 1 = cannot write the queue.
set -euo pipefail

QUEUE="${ARBOS_DEPLOY_QUEUE:-/var/lib/arbos-feedback/deploy-requests}"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/deploy/deploy-state.sh
. "$HERE/deploy-state.sh"

if [[ "${1:-}" == --observe ]]; then
  [[ $# == 2 ]] || exit 2
  case "$2" in relay|agentd|voice) ;; *) exit 2 ;; esac
  deploy_request_observe "$2"
  exit
fi
[[ $# == 2 || $# == 3 ]] || { echo "usage: arbos-deploy-hook <relay|agentd|voice> <sha> [receipt] | --observe <kind>" >&2; exit 2; }
kind="$1"; sha="$2"; expected="${3:-}"
case "$kind" in relay|agentd|voice) ;; *) echo "invalid deploy kind" >&2; exit 2 ;; esac
[[ "$sha" =~ ^[0-9a-fA-F]{7,40}$ ]] || { echo "invalid commit id" >&2; exit 2; }
sha="$(printf '%s' "$sha" | tr 'A-F' 'a-f')"
if [[ $# == 3 ]]; then
  deploy_receipt_valid "$expected" && [[ "$expected" == "$kind:"* ]] || { echo "invalid deploy receipt" >&2; exit 2; }
fi

queue_request_locked() {
  local kind="$1" sha="$2" expected="${3:-}" now file first prev_first prev_sha tmp current state by
  if [[ -n "$expected" ]]; then
    current="$(deploy_request_observe_locked "$kind")" || return 1
    state="$(deploy_publication_state "$expected" "$current")" || return 1
    [[ "$state" == Publish ]] || { echo "deferred: $kind decision changed"; return 75; }
  fi
  now="$(date -u +%s)"; file="$QUEUE/$kind"; first="$now"
  if deploy_request_valid "$file" "$kind"; then
    prev_first="$(sed -n 's/^first_requested_at=//p' "$file" | head -1)"
    first="$prev_first"
    prev_sha="$(sed -n 's/^sha=//p' "$file" | head -1)"
    if [[ "$prev_sha" == "$sha" ]]; then echo "queued already: $kind $sha"; return 0; fi
  fi
  by="$(id -un)" || return 1
  [[ "$by" =~ ^[A-Za-z0-9_.-]{1,64}$ ]] || return 1
  tmp="$(mktemp "$QUEUE/.$kind.XXXXXX")" || return 1
  if ! { printf 'kind=%s\nsha=%s\nrequested_at=%s\nfirst_requested_at=%s\nrequested_by=%s\n' "$kind" "$sha" "$now" "$first" "$by" > "$tmp" && chmod 0644 "$tmp"; }; then
    rm -f "$tmp"; return 1
  fi
  if ! deploy_request_advance "$kind" || ! mv -f "$tmp" "$file"; then
    rm -f "$tmp"; return 1
  fi
  echo "queued: $kind $sha"
}
deploy_queue_transaction "$QUEUE" queue_request_locked "$kind" "$sha" "$expected"
