# Copy to /etc/arbos/observability.env (root:root, mode 0600) and fill in. Never commit the copy.

# Grafana admin password. Read only when Grafana first creates its database; to change it later:
#   docker exec arbos-obs-grafana grafana cli admin reset-admin-password '<new>'
GF_SECURITY_ADMIN_PASSWORD=

# Where alerts go: a Discord webhook URL (Server Settings → Integrations → Webhooks → New Webhook →
# Copy Webhook URL). Empty means alerts are evaluated and shown but not delivered.
ALERT_WEBHOOK_URL=

# The public address Caddy serves Grafana on (Caddyfile.grafana); used for links and redirects.
GF_SERVER_ROOT_URL=https://grafana.arbos.life/

# The one account for the shareable Subnet view (created by grafana-access.sh): a Viewer in its own
# Grafana organisation. Login: a-z 0-9 _ -. Password: 16+ of A-Z a-z 0-9 . _ ~ -
#   openssl rand -hex 16
SUBNET_VIEWER_LOGIN=tobias
SUBNET_VIEWER_PASSWORD=
