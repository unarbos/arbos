# Throwaway values for the local run only (docker-compose.local.yml). Production reads
# /etc/arbos/observability.env, which is never committed.
GF_SECURITY_ADMIN_PASSWORD=local-only-not-a-secret
GF_SERVER_ROOT_URL=http://127.0.0.1:3300/
ALERT_WEBHOOK_URL=http://127.0.0.1:7799/hook

# Read by docker compose itself (--env-file local/local.env): where the two secret inputs live.
OBS_ENV_FILE=./local/local.env
OBS_SECRETS_DIR=./local
SUBNET_VIEWER_LOGIN=tobias
SUBNET_VIEWER_PASSWORD=local-only-not-a-secret
