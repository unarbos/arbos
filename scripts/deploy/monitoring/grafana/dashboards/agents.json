 "panels": [
  {
   "type": "stat",
   "title": "Boxes reporting",
   "description": "Awake boxes whose agentd answers the scrape. Every number on this page covers these boxes only.",
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": null,
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "value": null,
        "color": "green"
       }
      ]
     },
     "noValue": "\u2013"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 3,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(arbos_relay_box_scrapes{result=\"ok\"})",
     "legendFormat": "",
     "instant": false,
     "range": true
    }
   ]
  },
