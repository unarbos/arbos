{
 "uid": "arbos-boxes",
 "title": "Boxes",
 "tags": [
  "arbos"
 ],
 "editable": false,
 "schemaVersion": 39,
 "timezone": "browser",
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "graphTooltip": 1,
 "templating": {
  "list": [
   {
    "name": "box",
    "label": "Box",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(container_last_seen{name=~\"arbos-box-.+\"}, name)",
     "refId": "box"
    },
    "refresh": 2,
    "sort": 1,
    "multi": true,
    "includeAll": true,
    "allValue": "arbos-box-.+",
    "current": {
     "text": "All",
     "value": "$__all"
    }
   },
   {
    "name": "top",
    "label": "Top",
    "type": "custom",
    "query": "5,10,20",
    "current": {
     "text": "10",
     "value": "10"
    },
    "options": [
     {
      "text": "5",
      "value": "5",
      "selected": false
     },
     {
      "text": "10",
      "value": "10",
      "selected": true
     },
     {
      "text": "20",
      "value": "20",
      "selected": false
     }
    ]
   }
  ]
 },
