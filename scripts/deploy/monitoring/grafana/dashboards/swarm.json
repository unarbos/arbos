    "displayMode": "basic",
    "valueMode": "color",
    "showUnfilled": true,
    "namePlacement": "left",
    "minVizHeight": 16,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "id": 10,
   "gridPos": {
    "x": 17,
    "y": 4,
    "w": 7,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(arbos_relay_boxes_turn_running)",
     "legendFormat": "working",
     "instant": true,
     "range": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
