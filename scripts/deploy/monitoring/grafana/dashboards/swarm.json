{
 "uid": "arbos-swarm",
 "title": "Swarm",
 "tags": [
  "arbos"
 ],
 "editable": false,
 "schemaVersion": 39,
 "timezone": "browser",
 "refresh": "5s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "graphTooltip": 1,
 "templating": {
  "list": [
   {
    "name": "box",
    "label": "Box",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(container_last_seen{name=~\"arbos-box-.+\"}, name)",
     "refId": "box"
    },
    "refresh": 2,
    "sort": 1,
    "multi": true,
    "includeAll": true,
    "allValue": "arbos-box-.+",
    "current": {
     "text": "All",
     "value": "$__all"
    }
   },
   {
    "name": "top",
    "label": "Top",
    "type": "custom",
    "query": "5,10,20",
    "current": {
     "text": "10",
     "value": "10"
    },
    "options": [
     {
      "text": "5",
      "value": "5",
      "selected": false
     },
     {
      "text": "10",
      "value": "10",
      "selected": true
     },
     {
      "text": "20",
      "value": "20",
      "selected": false
     }
    ]
   }
  ]
 },
 "panels": [
  {
   "type": "stat",
   "title": "Working",
   "description": "Boxes with an agent turn running in the last 3 minutes.",
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": null,
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "value": null,
        "color": "green"
       }
      ]
     },
     "noValue": "\u2013"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 3,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(arbos_relay_boxes_turn_running)",
     "legendFormat": "",
     "instant": false,
     "range": true
    }
   ]
  },
  {
   "type": "stat",
   "title": "Running",
   "description": "arbos-box-* containers Docker is running.",
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": null,
