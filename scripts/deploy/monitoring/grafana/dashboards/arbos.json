    "defaults": {
     "unit": "short",
     "decimals": 0,
     "mappings": [
      {
       "type": "value",
       "options": {
        "-1": {
         "text": "no data yet",
         "color": "#6e7681"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "value": null,
        "color": "text"
       }
      ]
     },
     "noValue": "\u2013"
    },
    "overrides": []
