{
 "uid": "arbos",
 "title": "Arbos",
 "tags": [
  "arbos"
 ],
 "editable": false,
 "schemaVersion": 39,
 "timezone": "browser",
 "refresh": "10s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "graphTooltip": 1,
 "templating": {
  "list": []
 },
 "panels": [
  {
   "type": "stat",
   "title": "Service",
   "description": "The relay answers, on the server and from outside through its public name.",
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "Down"
        },
        "1": {
         "text": "Up"
        },
        "-1": {
         "text": "no data yet",
         "color": "#6e7681"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "value": null,
        "color": "#d55181"
       },
       {
        "value": 1,
        "color": "#199e70"
       }
      ]
     },
     "noValue": "\u2013"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   },
   "transparent": true,
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 3
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(subnet:relay_up * subnet:public_up) or vector(-1)",
     "legendFormat": "",
     "instant": false,
     "range": true
    }
   ]
  },
  {
   "type": "stat",
   "title": "Working now",
   "description": "Agent machines with a turn running in the last 3 minutes.",
