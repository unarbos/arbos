    "maxVizHeight": 22,
    "text": {
     "titleSize": 12,
     "valueSize": 16
    },
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "transformations": [
    {
     "id": "configFromData",
     "options": {
      "configRefId": "G",
      "mappings": [
       {
        "fieldName": "max",
        "handlerKey": "max"
       },
       {
        "fieldName": "Time",
        "handlerKey": "__ignore"
       }
      ]
     }
    }
   ],
   "id": 8,
   "gridPos": {
    "x": 16,
    "y": 3,
    "w": 8,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "subnet:boxes_working",
     "legendFormat": "working",
     "instant": true,
     "range": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "clamp_min(subnet:boxes_awake - subnet:boxes_working, 0)",
     "legendFormat": "awake, idle",
     "instant": true,
     "range": false
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
