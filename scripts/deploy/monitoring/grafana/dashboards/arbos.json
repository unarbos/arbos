     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(100 * subnet:spend_cap_ratio) or vector(-1)",
     "legendFormat": "",
     "instant": false,
     "range": true
    }
   ]
  },
  {
   "title": "Swarm",
   "description": "Every agent machine is one dot. Up: tokens per minute its agents are using. Right: CPU cores. Area: memory. Colour: what it is doing, as in the list on the right. A busy fleet rises off the floor; an idle one sits along it; sleeping machines are at the origin. Hover for the box; click to open it. Until the relay reports per box, every dot is grey and on the floor.",
   "transformations": [
    {
     "id": "joinByField",
     "options": {
      "byField": "name",
      "mode": "outer"
     }
    },
    {
     "id": "organize",
     "options": {
      "renameByName": {
       "Value #A": "CPU cores",
       "Value #B": "Memory",
       "Value #C": "State",
       "Value #D": "Tokens / min",
       "name": "Box"
      },
      "excludeByName": {
       "Time": true,
       "slot": true,
       "Time 1": true,
       "__name__ 1": true,
       "job 1": true,
       "instance 1": true,
       "Time 2": true,
       "__name__ 2": true,
       "job 2": true,
       "instance 2": true,
       "Time 3": true,
       "__name__ 3": true,
       "job 3": true,
       "instance 3": true,
       "Time 4": true,
       "__name__ 4": true,
       "job 4": true,
       "instance 4": true,
       "Time 5": true,
       "__name__ 5": true,
       "job 5": true,
       "instance 5": true,
       "Time 6": true,
       "__name__ 6": true,
       "job 6": true,
       "instance 6": true,
       "Time 7": true,
       "__name__ 7": true,
       "job 7": true,
       "instance 7": true,
       "Time 8": true,
       "__name__ 8": true,
       "job 8": true,
       "instance 8": true,
       "Time 9": true,
       "__name__ 9": true,
       "job 9": true,
       "instance 9": true,
       "Time 10": true,
       "__name__ 10": true,
       "job 10": true,
       "instance 10": true,
       "Time 11": true,
       "__name__ 11": true,
       "job 11": true,
       "instance 11": true
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "min": 0,
     "custom": {
      "show": "points",
      "pointSize": {
       "fixed": 8,
       "min": 6,
       "max": 44
      },
      "pointShape": "circle",
      "pointStrokeWidth": 1,
      "fillOpacity": 55,
      "axisPlacement": "auto",
      "scaleDistribution": {
       "type": "linear"
      }
     },
     "links": [
      {
       "title": "Open this box",
       "url": "/d/arbos-swarm/swarm?var-box=${__data.fields.Box}"
      }
     ],
     "noValue": "after the next relay update"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "CPU cores"
      },
      "properties": [
       {
        "id": "unit",
        "value": "short"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Memory"
      },
      "properties": [
       {
        "id": "unit",
        "value": "bytes"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "State"
      },
      "properties": [
       {
        "id": "unit",
        "value": "short"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Tokens / min"
      },
      "properties": [
       {
        "id": "unit",
        "value": "short"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "State"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "0": {
            "text": "unknown",
            "color": "#8b949e"
           },
           "1": {
            "text": "asleep",
            "color": "#57606a"
           },
           "2": {
            "text": "awake, idle",
            "color": "#3987e5"
           },
           "3": {
            "text": "waking",
            "color": "#c9d1d9"
           },
           "4": {
            "text": "working",
            "color": "#c98500"
           },
           "5": {
            "text": "error",
            "color": "#d55181"
           }
          }
         }
        ]
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "value": null,
           "color": "#8b949e"
          },
          {
           "value": 1,
           "color": "#57606a"
          },
          {
           "value": 2,
           "color": "#3987e5"
          },
          {
           "value": 3,
           "color": "#c9d1d9"
          },
          {
           "value": 4,
           "color": "#c98500"
          },
          {
           "value": 5,
           "color": "#d55181"
          }
         ]
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "thresholds"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "CPU cores"
      },
      "properties": [
       {
        "id": "custom.axisLabel",
        "value": "CPU cores"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Tokens / min"
      },
      "properties": [
       {
        "id": "custom.axisLabel",
        "value": "Tokens / min"
       }
      ]
     }
    ]
   },
   "type": "xychart",
   "pluginVersion": "13.2.6",
   "options": {
    "mapping": "manual",
    "series": [
     {
      "frame": {
       "matcher": {
        "id": "byIndex",
        "options": 0
       }
      },
      "x": {
       "matcher": {
        "id": "byName",
        "options": "CPU cores"
       }
      },
      "y": {
       "matcher": {
        "id": "byName",
        "options": "Tokens / min"
       }
      },
      "size": {
       "matcher": {
        "id": "byName",
        "options": "Memory"
       }
      },
      "color": {
       "matcher": {
        "id": "byName",
        "options": "State"
       }
      },
      "name": {
       "fixed": "box"
      }
     }
    ],
    "legend": {
     "showLegend": false
    },
    "tooltip": {
     "mode": "single",
     "sort": "none"
    }
   },
   "transparent": true,
   "id": 7,
   "gridPos": {
    "x": 0,
    "y": 3,
    "w": 16,
    "h": 10
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (name) (rate(container_cpu_usage_seconds_total{name=~\"arbos-box-.+\"}[2m])) or max by (name) (0 * label_replace(arbos_relay_box_info, \"name\", \"$1\", \"container\", \"(.+)\"))",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (name) (container_memory_working_set_bytes{name=~\"arbos-box-.+\"}) or max by (name) (0 * label_replace(arbos_relay_box_info, \"name\", \"$1\", \"container\", \"(.+)\"))",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (name) ((max by (box) (0 * arbos_relay_box_state{state=\"unknown\"} or 1 * arbos_relay_box_state{state=\"asleep\"} or 3 * arbos_relay_box_state{state=\"waking\"} or 5 * arbos_relay_box_state{state=\"error\"} or (2 * arbos_relay_box_state{state=\"awake\"} + on (box) 2 * clamp_max(arbos_relay_box_turn_running + on (box) (sum by (box) (rate(arbos_relay_box_tokens_total[1m])) > bool 0), 1)))) * on (box) group_left (name) label_replace(arbos_relay_box_info, \"name\", \"$1\", \"container\", \"(.+)\")) or max by (name) (0 * container_last_seen{name=~\"arbos-box-.+\"})",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "D",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (name) ((60 * sum by (box) (rate(arbos_relay_box_tokens_total[1m]))) * on (box) group_left (name) label_replace(arbos_relay_box_info, \"name\", \"$1\", \"container\", \"(.+)\")) or max by (name) (0 * container_last_seen{name=~\"arbos-box-.+\"})",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ]
  },
  {
