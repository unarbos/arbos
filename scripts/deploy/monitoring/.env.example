# Copy to /etc/arbos/monitoring.env (root:root, mode 0600) and fill in. Never commit the copy.
# Every value is required: compose refuses to start without the first three, and
# `grafana-access.sh --check` refuses weak or malformed ones.

# Passwords: 16-128 characters of A-Z a-z 0-9 . _ ~ -   (openssl rand -hex 24)

# Grafana admin password (login `admin`). Read only when Grafana first creates its database; to change it later:
#   docker exec arbos-mon-grafana grafana cli admin reset-admin-password '<new>'
GF_SECURITY_ADMIN_PASSWORD=

# Where alerts go: a Discord webhook URL, https:// (Server Settings → Integrations → Webhooks → New
# Webhook → Copy Webhook URL).
ALERT_WEBHOOK_URL=

# The public address Caddy serves Grafana on (Caddyfile.grafana); used for links and redirects.
GF_SERVER_ROOT_URL=https://grafana.arbos.life/

# The one account for the shareable Subnet view (created by grafana-access.sh): a Viewer in its own
# Grafana organisation. Login: a-z 0-9 _ -.
# The password must differ from the admin's.
SUBNET_VIEWER_LOGIN=tobias
SUBNET_VIEWER_PASSWORD=
