<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- The call keeps running with the app in the background or the screen
	     locked. This is also set as INFOPLIST_KEY_UIBackgroundModes, but the
	     generated value is only merged in by Xcode and a build that misses it
	     suspends the app mid-call with nothing to show why. Declared here so
	     it is in the bundle whatever the build settings do. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- FiraCode, which is what bittensor.com sets its chrome in. Declared here
	     and also registered at launch from the bundle (see `ArbosTheme.Face`):
	     the theme checks that the face actually resolved and falls back to the
	     system monospace if it did not, because a missing custom font otherwise
	     resolves silently to the proportional system face. -->
	<key>UIAppFonts</key>
	<array>
		<string>FiraCode-Regular.ttf</string>
		<string>FiraCode-Medium.ttf</string>
	</array>
</dict>
</plist>
