  "queries": {
    "relay_unread": "SELECT e.chat_id, e.project_id, COUNT(*) FROM chat_events e\n         WHERE e.id > COALESCE((SELECT r.event_id FROM chat_user_reads r WHERE r.user_id = ?1 AND r.chat_id = e.chat_id), 0)\n           AND (e.sender_user IS NULL OR e.sender_user != ?1)\n           AND (e.sender_user IS NULL OR e.sender_user NOT IN (SELECT blocked FROM blocks WHERE blocker = ?1))\n           AND NOT EXISTS (SELECT 1 FROM chat_user_archive a WHERE a.user_id = ?1 AND a.chat_id = e.chat_id)\n           AND (\n             e.chat_id IN (SELECT chat_id FROM people_members WHERE member = ?2 AND left_at IS NULL)\n             OR e.project_id IN (SELECT id FROM projects WHERE user_id = ?1)\n             OR e.project_id IN (SELECT project_id FROM project_members WHERE user_id = ?1 AND left_at IS NULL)\n           )\n         GROUP BY e.chat_id ORDER BY MAX(e.id) DESC",
    "box_fts": "SELECT t.id, t.thread_id, t.subagent_id, t.session_id, t.kind, t.role, t.at, t.text, t.size, bm25(t3_fts) AS score,\n                        snippet(t3_fts, 0, '[', ']', '\u2026', 24)\n                 FROM t3_fts JOIN t3 t ON t.id = t3_fts.id\n                 WHERE t3_fts MATCH ?1 AND (?2 IS NULL OR t.thread_id = ?2)\n                   AND (?3 IS NULL OR t.kind = ?3 OR (?3 = 'user' AND t.kind = ?6))\n                 ORDER BY score LIMIT ?4 OFFSET ?5",
    "box_job_for_worker": "SELECT id, chat_id, ask_message_id, subagent_id, title, kind, brief, touches, state, last_step, last_step_at, created_at, started_at, ended_at, error, delivered_key, restarts, steers FROM jobs WHERE subagent_id = ?1 ORDER BY created_at DESC LIMIT 1",
    "box_open_jobs": "SELECT id, chat_id, ask_message_id, subagent_id, title, kind, brief, touches, state, last_step, last_step_at, created_at, started_at, ended_at, error, delivered_key, restarts, steers FROM jobs WHERE state IN ('queued','running') ORDER BY created_at ASC"
  },
